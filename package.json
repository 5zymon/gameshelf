{
  "name": "gameshelf",
  "version": "0.1.0",
  "private": true,
  "description": "GameShelf — track, organize, and discover your video game library.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:deploy": "npm run db:deploy --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate:check": "npm run db:migrate:check --workspace apps/api",
    "platforms:sync": "npm run platforms:sync --workspace apps/api",
    "covers:redownload": "npm run covers:redownload --workspace apps/api",
    "db:studio": "npm run db:studio --workspace apps/api",
    "user:create": "npm run user:create --workspace apps/api --",
    "user:passwd": "npm run user:passwd --workspace apps/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint --workspaces --if-present -- --fix",
    "format": "prettier --write . '!data'",
    "format:check": "prettier --check . '!data'",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next apps/*/dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --fix --config apps/api/eslint.config.mjs",
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --config apps/web/eslint.config.mjs",
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "eslint --fix --config packages/contracts/eslint.config.mjs",
      "prettier --write"
    ],
    "**/*.{js,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0"
  }
}
