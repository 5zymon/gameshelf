// GameShelf — Prisma schema (ADR-003: Prisma is the data-access layer).
//
// Connection settings live in prisma.config.ts (Prisma ORM v7 moved them
// out of the schema file). The MySQL URL in the root .env carries an
// explicit ?charset=utf8mb4 suffix. Note: Prisma's MySQL connector does
// not parse that parameter — utf8mb4 is enforced anyway because the
// migration engine connects with utf8mb4 on MySQL >= 5.5.3 and every
// generated table declares DEFAULT CHARACTER SET utf8mb4 (README,
// "Migrations").

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// Game.source — where a record's data came from (spec distinguishes
// IGDB-sourced from MobyGames-sourced records; MANUAL is the default for
// hand-entered rows).
enum GameSource {
  IGDB
  MobyGames
  MANUAL
}

// Single permission level — NO role/permission column (decision #14).
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  // Preferred UI language (ticket 7.2). Defaults to Polish; the value is a
  // bounded code, not free text, so it fits the cookie and the wire contract.
  language     String   @default("pl") @db.VarChar(8)
  // Preferred UI theme (ticket 7.3): 'light' | 'dark' | 'system'. Defaults to
  // the OS preference; the closed set is enforced by the PUT validation.
  theme        String   @default("system") @db.VarChar(8)
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]

  @@map("users")
}

// Server-side session (ADR-004). The cookie holds a random token; `id` is
// its HMAC-SHA256 digest (keyed by SESSION_SECRET), never the raw token. As
// the primary key it is indexed (acceptance criterion).
model Session {
  id        String   @id @db.VarChar(255)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String?  @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Canonical platform record — defeats "PS5" vs "PlayStation 5" duplicates.
model Platform {
  id              Int     @id @default(autoincrement())
  name            String  @unique @db.VarChar(255)
  abbreviation    String? @db.VarChar(255)
  alternativeName String? @map("alternative_name") @db.VarChar(255)
  platformFamily  Int?    @map("platform_family")
  igdbId          Int?    @map("igdb_id")
  slug            String  @unique @db.VarChar(255)
  // Set when the import created this row for an unknown platform name (spec
  // §4.2.3/§4.6.6). Cleared by `confirm`; the row is deleted by `merge`.
  addedByImport   Boolean @default(false) @map("added_by_import")
  // Reference platforms without games can be hidden instead of deleted (a
  // refresh would bring them back — spec §4.6.5).
  hidden          Boolean @default(false)

  games   Game[]
  aliases PlatformAlias[]

  @@map("platforms")
}

// A stable matching key for a platform, separate from its displayed `name`:
// the old name after a rename, or the merged-away name after a merge. The
// normalized key is globally unique so one alias has exactly one owner.
model PlatformAlias {
  id             Int      @id @default(autoincrement())
  platformId     Int      @map("platform_id")
  name           String   @db.VarChar(255)
  normalizedName String   @unique @map("normalized_name") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at")

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId])
  @@map("platform_aliases")
}

// `edition` is a first-class attribute (research §4.2) — not IGDB-only.
// `rawMetadata` is archival (raw IGDB/MobyGames payload) and is NEVER
// queried; all queryable data is in the normalized columns (ADR-001).
model Game {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  platformId  Int        @map("platform_id")
  edition     String?    @db.VarChar(255)
  releaseYear Int?       @map("release_year")
  publisher   String?    @db.VarChar(255)
  genre       String?    @db.VarChar(255)
  playerCount Int?       @map("player_count")
  // Number of physical copies owned. Owning several copies is deliberate
  // (ticket 4.12): identity stays one catalog row, copies are counted here.
  copyCount   Int        @default(1) @map("copy_count")
  coverUrl    String?    @map("cover_url") @db.VarChar(2083)
  // External catalog cover URL (IGDB/MobyGames). Internal only: used by the
  // background retry and `covers:redownload` to re-fetch a missing local file.
  // Never serialized in a response (covers are always served same-origin).
  sourceCoverUrl String? @map("source_cover_url") @db.VarChar(2083)
  rawMetadata String?    @map("raw_metadata") @db.MediumText
  enrichedAt  DateTime?  @map("enriched_at")
  source      GameSource @default(MANUAL)
  // External catalog link: `source`+`externalId` identify the upstream row
  // (IGDB/MobyGames). Null for a MANUAL/manually-created game until re-enriched.
  externalId        Int?     @map("external_id")
  // Set when a game's platform could not be confidently confirmed; cleared when
  // the user fixes the platform or a re-enrichment confirms one.
  platformUnverified Boolean @default(false) @map("platform_unverified")
  // Provenance: JSON array of hand-edited metadata field names (never queried).
  userEditedFields  String?  @map("user_edited_fields") @db.VarChar(255)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  platform Platform @relation(fields: [platformId], references: [id])

  recognizedItems RecognizedItem[]
  images          GameImage[]

  @@index([platformId])
  @@index([edition])
  @@index([releaseYear])
  @@index([publisher])
  @@index([genre])
  @@index([playerCount])
  @@map("games")
}

// One row per uploaded photo (ADR-002: the queue's unit of work is the
// photo). `status` lifecycle (set by the import pipeline, ticket 3.x):
// queued -> processing -> done | needs_attention | failed; the user may
// then dismiss a needs_attention/failed job (spec §4.2.4). Kept as a
// bounded String (not an enum) because the values are application-level
// states, unlike Game.source.
model ImportJob {
  id              Int       @id @default(autoincrement())
  status          String    @db.VarChar(32)
  declaredCount   Int?      @map("declared_count")
  // Filename (not an absolute path) under IMPORT_PHOTOS_DIR; set by the
  // upload API (ticket 3.2), resolved and deleted by the pipeline (3.5/3.8).
  // Nullable so the existing createJob({}) callers and legacy rows stay valid.
  photoRef        String?   @map("photo_ref") @db.VarChar(255)
  recognizedCount Int       @default(0) @map("recognized_count")
  importedCount   Int       @default(0) @map("imported_count")
  unrecognizedCount Int     @default(0) @map("unrecognized_count")
  errorMessage    String?   @map("error_message") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  // Last time this run entered the queue (ticket 3.8): stamped by the upload
  // creation, by `retryJob` (reset to `queued`), and again by `markProcessing`
  // (when the worker actually starts). The photo sweep anchors its abandonment
  // window on this, not `createdAt`, so a job retried inside the 7-day failed
  // window keeps its photo. Nullable for legacy rows; `createdAt` is the
  // fallback in `decidePhotoSweep`.
  enqueuedAt      DateTime? @map("enqueued_at")
  // Set once, inside the same transaction that persists the recognized item
  // rows (ticket 3.5). Non-null means the single vision call already ran, so a
  // BullMQ retry never repeats it (acceptance criterion).
  visionCompletedAt DateTime? @map("vision_completed_at")
  // Groups every photo from one upload request (ticket 3.6), so aggregate
  // batch progress (X of Y) is durable and survives a restart.
  batchId         String?   @map("batch_id") @db.VarChar(64)
  // The BullMQ job currently backing this run (ticket 3.6); refreshed on a
  // user retry. Supplementary to the durable status, never authoritative.
  bullJobId       String?   @map("bull_job_id") @db.VarChar(64)

  unrecognizedItems UnrecognizedItem[]
  recognizedItems   RecognizedItem[]

  @@index([status])
  @@index([batchId])
  @@map("import_jobs")
}

// One recognized game per photo (ticket 3.5): the per-item outcome of a job,
// keyed `(importJobId, position)`. `status` is pending -> imported |
// unrecognized; the pending claim is what makes each item importable exactly
// once (idempotent retry) and lets a retry query only unresolved titles.
model RecognizedItem {
  id          Int      @id @default(autoincrement())
  importJobId Int      @map("import_job_id")
  position    Int
  rawTitle    String   @map("raw_title") @db.VarChar(255)
  rawEdition  String?  @map("raw_edition") @db.VarChar(255)
  rawPlatform String?  @map("raw_platform") @db.VarChar(255)
  confidence  Float
  status      String   @db.VarChar(16) // pending | imported | unrecognized
  gameId      Int?     @map("game_id")
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  game      Game?     @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([importJobId, position])
  @@index([importJobId, status])
  @@map("recognized_items")
}

// Trace for items the vision model could not match (decision #12).
// `rawTitle` is the raw recognized title — stored even though it is never
// imported into Game.
model UnrecognizedItem {
  id          Int      @id @default(autoincrement())
  importJobId Int      @map("import_job_id")
  rawTitle    String   @map("raw_title") @db.VarChar(255)
  rawPlatform String?  @map("raw_platform") @db.VarChar(255)
  reason      String?  @db.Text
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("unrecognized_items")
}

// One locally cached gallery image for a game (IGDB screenshots/artworks).
// `url` is a same-origin served path (/api/covers/<file>); `sourceUrl` is the
// external IGDB URL (internal, never serialized). Rows are replaced wholesale
// on re-enrichment, so `position` is the display order.
model GameImage {
  id        Int      @id @default(autoincrement())
  gameId    Int      @map("game_id")
  position  Int
  url       String   @db.VarChar(2083)
  sourceUrl String?  @map("source_url") @db.VarChar(2083)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, position])
  @@index([gameId])
  @@map("game_images")
}

// Runtime LLM provider settings (ticket 3.3). A singleton row (`id = 1`) so
// the user can switch provider/model and store a key after first run without
// touching env. `api_key_ciphertext` is AES-256-GCM (LlmKeyCryptoService),
// never stored or returned in plaintext. `base_url` (ticket 8.1) is the
// OpenAI-compatible endpoint for the `custom` provider; null for the built-ins.
model LlmSetting {
  id               Int      @id @default(autoincrement())
  provider         String   @db.VarChar(32)
  model            String?  @db.VarChar(128)
  baseUrl          String?  @map("base_url") @db.VarChar(512)
  apiKeyCiphertext String?  @map("api_key_ciphertext") @db.Text
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("llm_settings")
}

// Global photo-import queue pause state (ticket 3.10). Singleton row (`id = 1`).
// The operational pause lives in Redis (BullMQ `queue.pause()`); this row
// records WHY so the progress API can report a reason and it survives a
// restart. `paused` mirrors the last known state for the Redis-unavailable
// fallback; BullMQ remains authoritative when reachable.
model ImportQueueState {
  id        Int       @id @default(autoincrement())
  paused    Boolean   @default(false)
  reason    String?   @db.Text
  source    String?   @db.VarChar(16)
  pausedAt  DateTime? @map("paused_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("import_queue_state")
}
