{
  "name": "@gameshelf/api",
  "version": "0.1.0",
  "private": true,
  "description": "GameShelf HTTP API (NestJS).",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:platforms:fetch": "node prisma/igdb-platforms.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.5",
    "prisma": "7.10.0",
    "typescript": "^5.7.3"
  }
}
