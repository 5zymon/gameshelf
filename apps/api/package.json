{
  "name": "@gameshelf/api",
  "version": "0.1.0",
  "private": true,
  "description": "GameShelf HTTP API (NestJS).",
  "scripts": {
    "build": "prisma generate && nest build -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "platforms:sync": "ts-node -P tsconfig.json src/cli/platforms.ts",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:studio": "prisma studio",
    "user:create": "ts-node -P tsconfig.json src/cli/users.ts create",
    "user:passwd": "ts-node -P tsconfig.json src/cli/users.ts passwd"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.5",
    "jest": "^30.5.2",
    "mysql2": "^3.24.5",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
