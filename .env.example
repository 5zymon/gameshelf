# ---------------------------------------------------------------------------
# GameShelf environment variables
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# Placeholders only — never commit a real `.env` (it is gitignored).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- API (apps/api) --------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0

# --- Web (apps/web) --------------------------------------------------------
WEB_PORT=3000
# Internal API origin used server-side by the Next.js `/api/:path*` rewrite and
# by SSR (`lib/api.ts`). The browser NEVER calls this directly — it talks only to
# the web origin; do not point this at a reverse proxy or TLS terminator.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database (MySQL 8.4, utf8mb4) -------------------------------------------
# Local dev database. docker-compose.yml (dev convenience only) reads these.
# Change the passwords if you use this DB for anything beyond local dev.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gameshelf
MYSQL_USER=gameshelf
MYSQL_PASSWORD=gameshelf
MYSQL_ROOT_PASSWORD=gameshelf-root

# Prisma connection strings (read by apps/api/prisma.config.ts).
# The ?charset=utf8mb4 suffix declares the connection charset explicitly —
# do not rely on server defaults (ADR-001).
DATABASE_URL="mysql://gameshelf:gameshelf@localhost:3306/gameshelf?charset=utf8mb4"
# Shadow database for `prisma migrate dev` (created by docker/mysql-init).
DATABASE_SHADOW_URL="mysql://gameshelf:gameshelf@localhost:3306/gameshelf_shadow?charset=utf8mb4"
# E2E test database (separate from the dev DB; created by
# docker/mysql-init/02-test-database.sql). Used by `npm run test:e2e`.
DATABASE_TEST_URL="mysql://gameshelf:gameshelf@localhost:3306/gameshelf_test?charset=utf8mb4"

# Optional: set to 1 to print every SQL statement the API executes (dev aid
# for verifying query counts, e.g. no-N+1 checks). Off by default.
PRISMA_LOG_QUERIES=

# --- Redis (BullMQ job queue) ----------------------------------------------
# The app reads ONLY REDIS_HOST / REDIS_PORT for the queue connection.
REDIS_HOST=localhost
REDIS_PORT=6379
# Namespace for all BullMQ queue keys ("<prefix>:<queue>:..."). Optional;
# defaults to BullMQ's `bull`. The e2e suite uses its own prefix so it cannot
# touch a running dev queue.
REDIS_QUEUE_PREFIX=bull
# Present for convenience only — the app does NOT read this.
REDIS_URL=redis://localhost:6379

# --- Sessions / auth -------------------------------------------------------
# HMAC-SHA256 key for session tokens. REQUIRED: at least 32 characters.
# Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Sliding session lifetime in minutes. Must be a positive integer (there is no
# "never" value). Default 10080 = 7 days.
SESSION_TTL_MINUTES=10080

# Send the session cookie only over HTTPS. Set to `true` for TLS deployments;
# keep `false` for plain-HTTP LAN use. Strict values: true/1/false/0 (default false).
SESSION_COOKIE_SECURE=false

# --- LLM (vision) -----------------------------------------------------------
# Game recognition uses one OpenAI-compatible endpoint (Ollama, LM Studio, vLLM,
# OpenRouter, LiteLLM, …). Its base URL, model and key are set at runtime in
# Settings (`PUT /settings/llm`; key stored encrypted in `llm_settings`). The
# base URL has no env fallback, so photo import stays off until one is saved.
# Fallback API key when no encrypted DB key is stored:
# CUSTOM_API_KEY=placeholder
# Optional model override (blank = the stored model, if any).
LLM_MODEL=
# Secret used to derive the AES-256-GCM key that encrypts the stored API key.
# Optional: falls back to SESSION_SECRET when unset.
LLM_SETTINGS_SECRET=
# Reserved for a future provider; not read by the current code.
# ANTHROPIC_API_KEY=sk-ant-placeholder

# --- Photo import storage ---------------------------------------------------
# Ephemeral directory for uploaded photos while their import job runs. The
# import pipeline deletes each photo after its job completes (ticket 3.5). A
# periodic sweep (ticket 3.8) is the backstop: it removes files whose delete
# failed, dismissed jobs' photos, a failed job's photo after the 7-day retry
# window, abandoned queued/processing photos after 48 hours, and files with no
# owning job. Optional; defaults to <OS temp>/gameshelf-import-photos. The API
# never serves files from this directory (never a gallery).
IMPORT_PHOTOS_DIR=

# --- Cover cache ------------------------------------------------------------
# Durable directory for locally cached game covers. The import pipeline
# downloads each resolved candidate's cover once and rewrites the saved game's
# `coverUrl` to a same-origin `/api/covers/<file>` path (never an external
# host). A WebP thumbnail is generated locally per cover and served at
# `/api/covers/thumbs/<file>`. Optional; defaults to ~/.gameshelf/covers. The
# API serves files from this directory only through the authenticated cover
# routes.
COVERS_DIR=

# Comma-separated host allowlist for the signed `/api/covers/preview`
# passthrough used by re-enrichment search results (the browser never receives
# an external URL). Optional; defaults to the IGDB/MobyGames image hosts.
COVER_PREVIEW_HOSTS=

# HMAC key for preview URLs. Optional; falls back to SESSION_SECRET.
COVER_PREVIEW_SECRET=

# Interval in milliseconds between background cover-retry sweeps for failed
# downloads. Optional; defaults to 900000 (15 minutes).
COVER_RETRY_SWEEP_INTERVAL_MS=

# --- IGDB (Internet Game Database) ----------------------------------------
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret
# Optional. OAuth client-credentials token endpoint; defaults to the canonical
# Twitch endpoint (https://id.twitch.tv/oauth2/token). Only set this to
# override (e.g. a proxy or a mock in local testing).
IGDB_TOKEN_URL=

# --- MobyGames (optional fallback) ------------------------------------------
# Free non-commercial access is granted by application and is NOT instant.
# Leave this commented while no key is granted: the fallback is then skipped
# and imports validate against IGDB alone. Do NOT set a placeholder — a
# configured-but-rejected key pauses the photo-import queue (ticket 3.10).
# MOBYGAMES_API_KEY=
