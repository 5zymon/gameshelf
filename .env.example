# ---------------------------------------------------------------------------
# GameShelf environment variables
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# Placeholders only — never commit a real `.env` (it is gitignored).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- API (apps/api) --------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0

# --- Web (apps/web) --------------------------------------------------------
WEB_PORT=3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database (MySQL 8.4, utf8mb4) -------------------------------------------
# Local dev database. docker-compose.yml (dev convenience only) reads these.
# Change the passwords if you use this DB for anything beyond local dev.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gameshelf
MYSQL_USER=gameshelf
MYSQL_PASSWORD=gameshelf
MYSQL_ROOT_PASSWORD=gameshelf-root

# Prisma connection strings (read by apps/api/prisma.config.ts).
# The ?charset=utf8mb4 suffix declares the connection charset explicitly —
# do not rely on server defaults (ADR-001).
DATABASE_URL="mysql://gameshelf:gameshelf@localhost:3306/gameshelf?charset=utf8mb4"
# Shadow database for `prisma migrate dev` (created by docker/mysql-init).
DATABASE_SHADOW_URL="mysql://gameshelf:gameshelf@localhost:3306/gameshelf_shadow?charset=utf8mb4"
# E2E test database (separate from the dev DB; created by
# docker/mysql-init/02-test-database.sql). Used by `npm run test:e2e`.
DATABASE_TEST_URL="mysql://gameshelf:gameshelf@localhost:3306/gameshelf_test?charset=utf8mb4"

# Optional: set to 1 to print every SQL statement the API executes (dev aid
# for verifying query counts, e.g. no-N+1 checks). Off by default.
PRISMA_LOG_QUERIES=

# --- Redis (BullMQ job queue) ----------------------------------------------
# The app reads ONLY REDIS_HOST / REDIS_PORT for the queue connection.
REDIS_HOST=localhost
REDIS_PORT=6379
# Namespace for all BullMQ queue keys ("<prefix>:<queue>:..."). Optional;
# defaults to BullMQ's `bull`. The e2e suite uses its own prefix so it cannot
# touch a running dev queue.
REDIS_QUEUE_PREFIX=bull
# Present for convenience only — the app does NOT read this.
REDIS_URL=redis://localhost:6379

# --- Sessions / auth -------------------------------------------------------
# HMAC-SHA256 key for session tokens. REQUIRED: at least 32 characters.
# Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Sliding session lifetime in minutes. Must be a positive integer (there is no
# "never" value). Default 10080 = 7 days.
SESSION_TTL_MINUTES=10080

# Send the session cookie only over HTTPS. Set to `true` for TLS deployments;
# keep `false` for plain-HTTP LAN use. Strict values: true/1/false/0 (default false).
SESSION_COOKIE_SECURE=false

# --- LLM providers ---------------------------------------------------------
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder

# --- Photo import storage ---------------------------------------------------
# Ephemeral directory for uploaded photos while their import job runs. The
# import pipeline deletes each photo after processing (ticket 3.8). Optional;
# defaults to <OS temp>/gameshelf-import-photos. The API never serves files
# from this directory (never a gallery).
IMPORT_PHOTOS_DIR=

# --- IGDB (Internet Game Database) ----------------------------------------
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret
