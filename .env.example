# ---------------------------------------------------------------------------
# GameShelf environment variables
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# Placeholders only — never commit a real `.env` (it is gitignored).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development

# --- API (apps/api) --------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0

# --- Web (apps/web) --------------------------------------------------------
WEB_PORT=3000
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Database --------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://gameshelf:gameshelf@localhost:5432/gameshelf

# --- Redis -----------------------------------------------------------------
# Cache / job queue connection.
REDIS_URL=redis://localhost:6379

# --- Sessions / auth -------------------------------------------------------
# Secret used to sign session cookies (use a long random value).
SESSION_SECRET=change-me-to-a-long-random-string

# --- LLM providers ---------------------------------------------------------
OPENAI_API_KEY=sk-placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder

# --- IGDB (Internet Game Database) ----------------------------------------
IGDB_CLIENT_ID=your-igdb-client-id
IGDB_CLIENT_SECRET=your-igdb-client-secret
